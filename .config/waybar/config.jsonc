{
  "layer": "top",
  "position": "top",
  "height": 35,
  "spacing": 5,
  "margin-top": 4,
  "margin-bottom": 0,
  "margin-right": 4,
  "margin-left": 4,

  "modules-center": ["custom/rofi", "group/workspaces", "mpris"],

  // Per-host modules-left/right. First match wins (waybar never overrides a
  // key already set), so hosts/<hostname>.jsonc beats hosts/default.jsonc.
  // Keep "modules-left"/"modules-right" out of this file or they override both.
  "include": [
    "~/.config/waybar/hosts/$(cat /etc/hostname).jsonc",
    "~/.config/waybar/hosts/default.jsonc",
  ],

  "custom/rofi": {
		"format": "󰮯",
		"on-click": "rofi -show drun",
    "on-click-right": "sh ~/.config/waybar/scripts/power-menu.sh",
    "escape" : true,
    "tooltip" : false
	},

  // Modules configuration
  // Replaces hyprland/workspaces: its clicks send legacy "dispatch workspace N",
  // which the Lua config rejects. scripts/workspaces.py tracks state and
  // signals these modules (RTMIN+8); 1-5 always shown, 6-10 only while they exist.
  "group/workspaces": {
    "orientation": "inherit",
    "modules": [
      "custom/ws-listener",
      "custom/ws#1",
      "custom/ws#2",
      "custom/ws#3",
      "custom/ws#4",
      "custom/ws#5",
      "custom/ws#6",
      "custom/ws#7",
      "custom/ws#8",
      "custom/ws#9",
      "custom/ws#10",
    ],
  },

  // Prints nothing (stays hidden); lives and dies with waybar.
  "custom/ws-listener": {
    "exec": "~/.config/waybar/scripts/workspaces.py",
    "tooltip": false,
  },

  "custom/ws#1": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/1.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'",
  },
  "custom/ws#2": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/2.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'",
  },
  "custom/ws#3": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/3.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'",
  },
  "custom/ws#4": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/4.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'",
  },
  "custom/ws#5": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/5.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'",
  },
  "custom/ws#6": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/6.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'",
  },
  "custom/ws#7": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/7.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'",
  },
  "custom/ws#8": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/8.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'",
  },
  "custom/ws#9": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/9.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'",
  },
  "custom/ws#10": {
    "exec": "cat $XDG_RUNTIME_DIR/waybar-ws/10.json 2>/dev/null",
    "return-type": "json",
    "signal": 8,
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 10 })'",
  },

  "hyprland/window": {
    "format": "{class}",
    "max-length": 20,
    "rewrite": {
      "": " hyprland",
      "~": " terminal",
      "com.mitchellh.ghostty": ">> ghostty",
      "zen-beta": ">> zen"
    }
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": " {volume}%",
    "format-muted": " {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲 {volume}%",
    "format-source": "{volume}% ",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false,
    "max-volume": 130
  },

  "battery#bat2": {
    "bat": "BAT2"
  },

  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20
    },
    "format-icons": ["","","","",""],
    "format": "{icon} {capacity}%",
    "format-critical": "{icon} {capacity}%",
    "format-warning": "{icon} {capacity}%",
    "format-full": "{icon} {capacity}%",
    "format-charging": "󰂅 {capacity}%",
    "format-charging-warning": "󰢝 {capacity}%",
    "format-charging-critical": "󰢜 {capacity}%",
    "format-plugged": "󰂅 {capacity}%",
    "format-alt": "󱧥 {time}",
    "tooltip": false
  },

  "clock": {
    "format": "󰃭 {:%a %d %b}  󱑂 {:%I:%M %p}",
    "tooltip": false,
  },

  // Click toggles a floating btop/nvtop. The ^ anchor keeps pkill from
  // matching the sh -c that waybar wraps the command in.
  "custom/cpu": {
    "exec": "~/.config/waybar/scripts/cpu-status.sh 2",
    "return-type": "json",
    "format": "{}",
    "on-click": "pkill -f '^kitty --class sysmon-cpu' || kitty --class sysmon-cpu -e btop",
  },

  "memory": {
    "format": "󰍛 {used:0.1f}/{total:0.0f}G",
    "interval": 5,
    "states": { "warning": 80, "critical": 95 },
    "tooltip-format": "RAM:  {used:0.1f} / {total:0.1f} GiB ({percentage}%)\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
    "on-click": "pkill -f '^kitty --class sysmon-cpu' || kitty --class sysmon-cpu -e btop",
  },

  "custom/disk": {
    "exec": "~/.config/waybar/scripts/disk-status.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 60,
  },

  "custom/gpu": {
    "exec": "~/.config/waybar/scripts/gpu-status.sh 2",
    "exec-if": "command -v nvidia-smi",
    "return-type": "json",
    "format": "{}",
    "on-click": "pkill -f '^kitty --class sysmon-gpu' || kitty --class sysmon-gpu -e nvtop",
  },

  "custom/backlight": {
    "exec": "~/.config/waybar/scripts/brightness-control.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-scroll-up": "~/.config/waybar/scripts/brightness-control.sh -o i",
    "on-scroll-down": "~/.config/waybar/scripts/brightness-control.sh -o d",
    "interval": 1
  },

  "custom/paddc": {
    "format": " ",
    "tooltip": false
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "US"
  },

  "mpris": {
    "format": "󰎇 {artist} - {title}",
    "max-length": 40
  },

  "custom/wifi": {
    "exec": "~/.config/waybar/scripts/wifi-status.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "interval": 1
  },

  "bluetooth": {
    "format": "󰂰",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",

    "tooltip-format": 
      "{num_connections} connected",
    "tooltip-format-disabled": 
      "Bluetooth Disabled",
    "tooltip-format-connected": 
      "{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": 
      "{device_alias}",
    "tooltip-format-enumerate-connected-battery": 
      "{device_alias}: {device_battery_percentage}%",

    "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
    "interval": 1
  },

  "custom/openrouter-cost": {
    "exec": "~/.config/waybar/scripts/openrouter-cost.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 300,
    "tooltip": true,
    "on-click": "xdg-open https://openrouter.ai/activity"
  },

  "custom/notification": {
    "tooltip": false,
    "rotate": 0,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰅸",
      "none": "󰂜",
      "dnd-notification": "󰅸",
      "dnd-none": "󱏨",
      "inhibited-notification": "󰅸",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰅸",
      "dnd-inhibited-none": "󱏨"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click-right": "swaync-client -d -sw",
    "on-click": "swaync-client -t -sw",
    "escape": true
  }
}
